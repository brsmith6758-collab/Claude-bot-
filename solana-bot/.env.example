# --- Connection ---
# Use a dedicated RPC (Helius, QuickNode, Triton) for production. Public RPC is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Wallet ---
# Base58-encoded private key (as exported from Phantom) OR a JSON array of bytes.
# NEVER commit this file. Use a dedicated hot wallet with limited funds.
WALLET_PRIVATE_KEY=

# --- Trading pair ---
# INPUT_MINT is what you spend, OUTPUT_MINT is what you buy.
# SOL:  So11111111111111111111111111111111111111112
# USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# BONK: DezXAZ8z7PnrnRJjz3wXBoRgixCa6xjnB7YaB1pPB263
INPUT_MINT=So11111111111111111111111111111111111111112
OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Amount of input token to spend per buy (in whole units, e.g. 0.01 SOL)
TRADE_SIZE=0.01

# --- Strategy: dca | momentum ---
STRATEGY=dca

# DCA: buy every N seconds
DCA_INTERVAL_SEC=300

# Momentum: poll price every N seconds, keep SMA over N samples
PRICE_INTERVAL_SEC=10
SMA_PERIOD=20
# Buy when price is BUY_DIP_PCT below SMA; sell when SELL_PUMP_PCT above SMA
BUY_DIP_PCT=2
SELL_PUMP_PCT=3

# --- Risk management ---
# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BPS=50
# Close position if it drops STOP_LOSS_PCT below entry or rises TAKE_PROFIT_PCT above
STOP_LOSS_PCT=10
TAKE_PROFIT_PCT=20
# Max number of buys before the bot stops (0 = unlimited)
MAX_TRADES=0

# Set to true to simulate trades without sending transactions
DRY_RUN=true
